<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ClashSharp.Installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <ClashSharpInstallerInternalCandidate Condition="'$(ClashSharpInstallerInternalCandidate)' == ''">false</ClashSharpInstallerInternalCandidate>
    <ClashSharpInstallerPinnedSelfSignedRelease Condition="'$(ClashSharpInstallerPinnedSelfSignedRelease)' == ''">false</ClashSharpInstallerPinnedSelfSignedRelease>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ClashSharpInstallerInternalCandidate)' == 'true'">
    <DefineConstants>$(DefineConstants);CLASHSHARP_INSTALLER_INTERNAL_CANDIDATE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ClashSharpInstallerPinnedSelfSignedRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);CLASHSHARP_INSTALLER_PINNED_SELF_SIGNED_RELEASE</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateClashSharpInternalCandidateProfile" BeforeTargets="PrepareForBuild"
          Condition="'$(ClashSharpInstallerInternalCandidate)' == 'true'">
    <Error Condition="'$(ClashSharpFormalInstallerBuild)' != 'true' or '$(ClashSharpEnableInstallerMutationRuntime)' != 'true'"
           Text="An internal candidate requires the signed production Installer profile." />
  </Target>

  <Target Name="ValidateClashSharpPinnedSelfSignedReleaseProfile" BeforeTargets="PrepareForBuild"
          Condition="'$(ClashSharpInstallerPinnedSelfSignedRelease)' == 'true'">
    <Error Condition="'$(ClashSharpFormalInstallerBuild)' != 'true' or '$(ClashSharpEnableInstallerMutationRuntime)' != 'true'"
           Text="A pinned self-signed release requires the signed production Installer profile." />
    <Error Condition="'$(ClashSharpInstallerInternalCandidate)' == 'true'"
           Text="A pinned self-signed release cannot also be an internal candidate." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ClashSharp.Core\ClashSharp.Core.csproj" />
    <ProjectReference Include="..\ClashSharp.Installer.Core\ClashSharp.Installer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClashSharp.Installer.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Windows\WindowsDirectorySecuritySnapshot.cs" Link="Shared\WindowsDirectorySecuritySnapshot.cs" />
    <Compile Include="..\Shared\Windows\WindowsRegionalDefaults.cs" Link="Shared\WindowsRegionalDefaults.cs" />
    <Compile Include="..\Shared\Windows\WindowsDirectoryReadLease.cs" Link="Shared\WindowsDirectoryReadLease.cs" />
    <Compile Include="..\Shared\Windows\WindowsDirectoryAccessPolicy.cs" Link="Shared\WindowsDirectoryAccessPolicy.cs" />
  </ItemGroup>
</Project>
