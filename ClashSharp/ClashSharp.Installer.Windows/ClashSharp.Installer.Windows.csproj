<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ClashSharp.Installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClashSharp.Core\ClashSharp.Core.csproj" />
    <ProjectReference Include="..\ClashSharp.Installer.Core\ClashSharp.Installer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClashSharp.Installer.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Windows\WindowsDirectorySecuritySnapshot.cs" Link="Shared\WindowsDirectorySecuritySnapshot.cs" />
    <Compile Include="..\Shared\Windows\WindowsDirectoryReadLease.cs" Link="Shared\WindowsDirectoryReadLease.cs" />
    <Compile Include="..\Shared\Windows\WindowsDirectoryAccessPolicy.cs" Link="Shared\WindowsDirectoryAccessPolicy.cs" />
  </ItemGroup>
</Project>
