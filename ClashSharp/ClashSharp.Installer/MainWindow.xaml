<Window x:Class="ClashSharp.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClashSharp 安装程序"
        Width="720" Height="480" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource InstallerWindowStyle}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="ClashSharp 安装程序"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0,0,0,1">
      <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Width="32" Height="32" Source="{StaticResource ClashSharpBrandMark}"
               AutomationProperties.Name="ClashSharp 标志" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="ClashSharp" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0">
            <Run Text="版本 " />
            <Run Text="{Binding DisplayVersion, Mode=OneWay}" />
            <Run Text=" · x64" />
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
          <Hyperlink Command="{Binding RefreshCommand}"
                     AutomationProperties.Name="重新检查安装状态"
                     AutomationProperties.HelpText="重新读取此电脑上的安装状态。">重新检查</Hyperlink>
        </TextBlock>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="24,24,24,20">
        <StackPanel AutomationProperties.Name="ClashSharp 安装状态">
          <TextBlock Text="{Binding StatusTitle, Mode=OneWay}" FontSize="20"
                     Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Margin="0,10,0,0" Text="{Binding StatusDetail, Mode=OneWay}"
                     Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Margin="0,20,0,0"
                      Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         AutomationProperties.Name="操作进度"
                         AutomationProperties.HelpText="{Binding ProgressStatus, Mode=OneWay}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding ProgressStatus, Mode=OneWay}"
                       Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </StackPanel>
        <Border Margin="0,18,0,0" Padding="16" Style="{StaticResource InstallerConfirmationStyle}"
                AutomationProperties.Name="切换账户确认"
                IsVisibleChanged="OnOwnerTransferConfirmationVisibilityChanged"
                Visibility="{Binding IsOwnerTransferConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="{Binding OwnerTransferConfirmationTitle}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Margin="0,10,0,16" Style="{StaticResource MutedTextStyle}"
                       Text="ClashSharp 的系统服务将改为供当前 Windows 账户使用。以前账户的应用和配置会保留，但该账户将无法继续连接此服务。" />
            <WrapPanel HorizontalAlignment="Right">
              <Button x:Name="DeclineOwnerTransferButton" Margin="0,0,10,0" Content="暂不切换" Command="{Binding DeclineOwnerTransferCommand}"
                      IsCancel="True" AutomationProperties.Name="取消账户切换" />
              <Button Content="确认切换并继续" Command="{Binding ConfirmOwnerTransferCommand}"
                      Style="{StaticResource InstallerPrimaryButtonStyle}"
                      AutomationProperties.Name="确认切换使用账户并继续安装" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Margin="0,18,0,0" Padding="16" Style="{StaticResource InstallerConfirmationStyle}"
                AutomationProperties.Name="卸载此账户副本确认"
                IsVisibleChanged="OnRetiredUninstallConfirmationVisibilityChanged"
                Visibility="{Binding IsRetiredUninstallConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="卸载此账户副本？" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Margin="0,10,0,16" Style="{StaticResource MutedTextStyle}"
                       Text="将移除此 Windows 账户的 ClashSharp 应用包，并清理安装器为此账户保留的证书。其他账户使用的共享服务保持原状。已有卸载进度会继续完成。" />
            <WrapPanel HorizontalAlignment="Right">
              <Button x:Name="DeclineRetiredUninstallButton" Margin="0,0,10,0" Content="暂不卸载"
                      Command="{Binding DeclineRetiredUninstallCommand}" IsCancel="True"
                      AutomationProperties.Name="取消卸载此账户副本" />
              <Button Content="确认卸载此账户副本" Command="{Binding ConfirmRetiredUninstallCommand}"
                      Style="{StaticResource InstallerPrimaryButtonStyle}"
                      AutomationProperties.Name="确认卸载此账户的 ClashSharp 副本" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Expander Margin="0,22,0,0" Header="详细信息"
                  AutomationProperties.Name="展开安装详细信息和诊断">
          <Border Margin="0,12,0,0" Padding="18"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="1">
            <StackPanel>
              <StackPanel Margin="0,0,0,18"
                          Visibility="{Binding IsOwnerTransferActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="使用账户" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedTextStyle}"
                           Text="此电脑曾由其他 Windows 账户安装 ClashSharp 时，可将服务切换到当前账户，或继续上次未完成的切换。" />
                <Button Content="切换使用账户…" Command="{Binding OwnerTransferCommand}" HorizontalAlignment="Left"
                        AutomationProperties.Name="检查并切换 ClashSharp 的使用账户" />
              </StackPanel>
              <StackPanel Margin="0,0,0,18"
                          Visibility="{Binding IsRetiredUninstallActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="旧账户副本" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedTextStyle}"
                           Text="服务已切换给其他账户后，可单独卸载此账户的应用副本，或继续未完成的副本卸载。" />
                <Button Content="卸载此账户副本…" Command="{Binding RetiredUninstallCommand}" HorizontalAlignment="Left"
                        AutomationProperties.Name="卸载此账户的 ClashSharp 副本或继续卸载" />
              </StackPanel>
              <TextBlock Text="安装内容" FontWeight="SemiBold" />
              <TextBlock Margin="0,6,0,16"
                         Text="桌面应用安装到 Windows 管理的应用目录；代理服务使用固定的系统目录。"
                         Style="{StaticResource MutedTextStyle}" />
              <ItemsControl ItemsSource="{Binding Capabilities, Mode=OneWay}"
                            AutomationProperties.Name="安装检查结果">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Detail}"
                                   Style="{StaticResource MutedTextStyle}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,4,0,6" Text="诊断代码" FontWeight="SemiBold" />
              <TextBox Padding="8,6" Text="{Binding DiagnosticCode, Mode=OneWay}"
                       IsReadOnly="True" IsReadOnlyCaretVisible="True"
                       HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="可复制的诊断代码" />
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,12"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0,1,0,0">
      <WrapPanel HorizontalAlignment="Right" AutomationProperties.Name="安装操作">
        <Button Margin="0,0,8,0" Content="{Binding SecondaryActionText, Mode=OneWay}"
                Command="{Binding SecondaryActionCommand}"
                Visibility="{Binding IsSecondaryActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="{Binding SecondaryActionText, StringFormat=执行{0}}" />
        <Button Margin="0,0,8,0" Content="{Binding PrimaryActionText, Mode=OneWay}"
                Command="{Binding PrimaryActionCommand}"
                Visibility="{Binding IsPrimaryActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource InstallerPrimaryButtonStyle}" IsDefault="True"
                AutomationProperties.Name="{Binding PrimaryActionText, StringFormat=执行{0}}" />
        <Button Margin="0,0,8,0" Content="取消(_C)" Command="{Binding CancelCommand}"
                Visibility="{Binding IsCancelActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsCancel="True" AutomationProperties.Name="取消当前操作" />
        <Button Content="关闭(_X)" Click="OnCloseClicked"
                AutomationProperties.Name="关闭安装器"
                AutomationProperties.HelpText="操作进行中时会先请求取消并等待收尾。" />
      </WrapPanel>
    </Border>
  </Grid>
</Window>
