<Window x:Class="ClashSharp.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClashSharp 安装器"
        Width="1120"
        Height="720"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="ClashSharp 安装器"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image Width="34"
               Height="34"
               VerticalAlignment="Center"
               Source="{StaticResource ClashSharpBrandMark}"
               Stretch="Uniform"
               AutomationProperties.Name="ClashSharp 标志" />
        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="ClashSharp Installer"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Margin="0,2,0,0"
                     Text="独立、自包含的 Windows 安装器"
                     FontSize="12"
                     Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
        <Button Grid.Column="2"
                VerticalAlignment="Center"
                Content="_重新检查"
                Command="{Binding RefreshCommand}"
                AutomationProperties.Name="重新检查安装器状态"
                AutomationProperties.HelpText="不会修改系统，只重新读取可信运行时状态。" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
      <Grid Margin="32,26,32,30"
            MaxWidth="980"
            HorizontalAlignment="Stretch">
        <Border Style="{StaticResource InstallerCardStyle}"
                Padding="0"
                AutomationProperties.Name="ClashSharp 产品实例">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="26,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Width="56"
                      Height="56"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      CornerRadius="7"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                      BorderThickness="1">
                <Image Width="42"
                       Height="42"
                       Source="{StaticResource ClashSharpBrandMark}"
                       Stretch="Uniform"
                       AutomationProperties.Name="ClashSharp 产品标志" />
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ClashSharp for Windows"
                           FontSize="21"
                           FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}">
                  <Run Text="版本 " />
                  <Run Text="{Binding DisplayVersion, Mode=OneWay}" />
                  <Run Text="  ·  Windows 11+ x64" />
                </TextBlock>
              </StackPanel>

              <Border Grid.Column="2"
                      Margin="20,0,0,0"
                      Padding="12,6"
                      VerticalAlignment="Top"
                      CornerRadius="14"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                      BorderThickness="1">
                <TextBlock Text="{Binding StatusBadge, Mode=OneWay}"
                           FontWeight="SemiBold"
                           AutomationProperties.Name="{Binding StatusBadge, StringFormat=当前状态：{0}}" />
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Padding="26,20"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,1,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,30,0">
                  <TextBlock Text="{Binding StatusTitle, Mode=OneWay}"
                             FontSize="17"
                             FontWeight="SemiBold"
                             AutomationProperties.HeadingLevel="Level2"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Margin="0,7,0,0"
                             Text="{Binding StatusDetail, Mode=OneWay}"
                             Style="{StaticResource MutedTextStyle}"
                             AutomationProperties.LiveSetting="Polite" />
                  <ProgressBar Margin="0,18,0,0"
                               Value="{Binding ProgressValue, Mode=OneWay}"
                               IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                               AutomationProperties.Name="安装进度"
                               AutomationProperties.HelpText="{Binding ProgressStatus, Mode=OneWay}" />
                  <TextBlock Margin="0,7,0,0"
                             Text="{Binding ProgressStatus, Mode=OneWay}"
                             Style="{StaticResource MutedTextStyle}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="18,4"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        CornerRadius="4">
                  <StackPanel>
                    <TextBlock Margin="0,8"
                               Text="执行前提"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Capabilities, Mode=OneWay}"
                                  AutomationProperties.Name="执行前提列表">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Detail}" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="{Binding StateText}"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="{Binding StateText, StringFormat=前提状态：{0}}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="26,18,26,16">
              <UniformGrid Columns="3">
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="应用位置" FontWeight="SemiBold" />
                  <TextBlock Margin="0,5,0,0"
                             Text="Windows 管理的 MSIX 目录"
                             Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="系统组件" FontWeight="SemiBold" />
                  <TextBlock Margin="0,5,0,0"
                             Text="固定 Program Files / ProgramData 目录"
                             Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="载荷方式" FontWeight="SemiBold" />
                  <TextBlock Margin="0,5,0,0"
                             Text="本地、自包含、签名并锁定"
                             Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
              </UniformGrid>

              <Expander Margin="0,17,0,0"
                        Header="诊断详情"
                        AutomationProperties.Name="展开诊断详情">
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="稳定诊断代码"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                  <TextBox Grid.Column="1"
                           Padding="8,5"
                           Text="{Binding DiagnosticCode, Mode=OneWay}"
                           IsReadOnly="True"
                           IsReadOnlyCaretVisible="True"
                           HorizontalScrollBarVisibility="Auto"
                           AutomationProperties.Name="稳定诊断代码" />
                </Grid>
              </Expander>
            </StackPanel>

            <Border Grid.Row="3"
                    Padding="26,15"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="所需空间：等待可信清单"
                             FontWeight="SemiBold" />
                  <TextBlock Margin="0,3,0,0"
                             Text="所有状态只由可信运行时决定。"
                             Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="20,0,10,0"
                        VerticalAlignment="Center"
                        Content="_取消"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsCancelActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsCancel="True"
                        AutomationProperties.Name="取消当前操作" />
                <Button Grid.Column="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="{Binding SecondaryActionText, Mode=OneWay}"
                        Command="{Binding SecondaryActionCommand}"
                        Visibility="{Binding IsSecondaryActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding SecondaryActionText, StringFormat=执行{0}}"
                        AutomationProperties.HelpText="仅显示可信运行时为当前安装状态明确授权的次要维护动作。" />
                <Button Grid.Column="3"
                        VerticalAlignment="Center"
                        Content="{Binding PrimaryActionText, Mode=OneWay}"
                        Command="{Binding PrimaryActionCommand}"
                        Visibility="{Binding IsPrimaryActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource InstallerPrimaryButtonStyle}"
                        IsDefault="True"
                        AutomationProperties.Name="{Binding PrimaryActionText, StringFormat=执行{0}}"
                        AutomationProperties.HelpText="仅当可信运行时证明全部执行前提后才可用。" />
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
