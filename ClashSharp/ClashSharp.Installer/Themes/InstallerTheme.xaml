<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Kept geometrically identical to the canonical 1024-unit SVG brand mark. -->
  <DrawingImage x:Key="ClashSharpBrandMark">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M 514,123 C 502,123 490,127 479,133 L 208,289 C 188,301 176,322 176,346 L 176,663 C 176,688 189,709 210,721 L 479,877 C 501,889 527,889 548,877 L 819,721 C 840,709 852,688 852,663 L 852,346 C 852,322 840,301 819,289 L 548,133 C 537,127 526,123 514,123 Z">
        <DrawingGroup.Children>
          <GeometryDrawing Geometry="M 514,123 C 502,123 490,127 479,133 L 208,289 C 188,301 176,322 176,346 L 176,663 C 176,688 189,709 210,721 L 479,877 C 501,889 527,889 548,877 L 819,721 C 840,709 852,688 852,663 L 852,346 C 852,322 840,301 819,289 L 548,133 C 537,127 526,123 514,123 Z">
            <GeometryDrawing.Brush>
              <LinearGradientBrush MappingMode="Absolute"
                                   StartPoint="307,188"
                                   EndPoint="721,842">
                <GradientStop Offset="0" Color="#0C7428" />
                <GradientStop Offset="0.48" Color="#0B7026" />
                <GradientStop Offset="1" Color="#0A6822" />
              </LinearGradientBrush>
            </GeometryDrawing.Brush>
          </GeometryDrawing>
          <GeometryDrawing Brush="#29033E15"
                           Geometry="M 443,290 H 508 L 988,770 L 915,1214 H 850 L 370,734 Z" />
          <GeometryDrawing Brush="#29033E15"
                           Geometry="M 598,290 H 664 L 1144,770 L 1071,1213 H 1006 L 526,733 Z" />
          <GeometryDrawing Brush="#29033E15"
                           Geometry="M 340,402 H 713 L 1193,882 V 949 H 820 L 340,469 Z" />
          <GeometryDrawing Brush="#29033E15"
                           Geometry="M 316,556 H 689 L 1169,1036 V 1103 H 796 L 316,623 Z" />
          <GeometryDrawing Brush="#29033E15"
                           Geometry="M 275,649 H 351 L 831,1129 V 1213 H 755 L 275,733 Z" />
          <!-- Separate layers preserve SVG overlap: no even-odd holes in the hash. -->
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M 443,290 H 508 L 435,733 H 370 Z" />
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M 598,290 H 664 L 591,733 H 526 Z" />
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M 340,402 H 713 V 469 H 340 Z" />
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M 316,556 H 689 V 623 H 316 Z" />
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M 351,662 L 339,674 C 332,668 324,665 315,665 C 301,665 292,676 292,691 C 292,706 301,717 315,717 C 324,717 332,713 339,707 L 351,719 C 341,728 329,733 315,733 C 291,733 275,715 275,691 C 275,667 291,649 315,649 C 329,649 341,654 351,662 Z" />
        </DrawingGroup.Children>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="Hyperlink" BasedOn="{StaticResource DefaultHyperlinkStyle}">
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="InstallerProgressBarStyle" TargetType="ProgressBar"
         BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>

  <Style x:Key="InstallerWindowStyle" TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="InstallerConfirmationStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="InstallerPrimaryButtonStyle" TargetType="Button"
         BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <!-- Same footprint as the primary button for actions that sit beside the page's single accent action. -->
  <Style x:Key="InstallerSecondaryButtonStyle" TargetType="Button"
         BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <!-- Expandable detail attached directly below a setting row, in the same card geometry. -->
  <Style x:Key="InstallerDetailExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="InstallerDetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,24,8" />
  </Style>

  <Style x:Key="InstallerDetailValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="InstallerSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="1,20,0,6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Match the application's flat setting rows and its text/action hierarchy. -->
  <Style x:Key="InstallerSettingRowBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Header is the title, Tag is the explanatory text, and Content remains the
       logical child so native control names, bindings, and automation are retained. -->
  <Style x:Key="InstallerSettingRowStyle" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border Style="{StaticResource InstallerSettingRowBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="OptionTextPanel" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                <TextBlock Text="{TemplateBinding Tag}" Margin="0,4,0,0"
                           Style="{StaticResource MutedTextStyle}" FontSize="12" />
              </StackPanel>
              <ContentPresenter x:Name="OptionAction" Grid.Column="1" VerticalAlignment="Center"
                                ContentSource="Content" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Keep CheckBox's native keyboard and Toggle automation contracts. Only its
       presentation changes to the switch used by the application's setting rows. -->
  <Style x:Key="InstallerToggleSwitchStyle" TargetType="CheckBox"
         BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=HeaderedContentControl}}" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <Style TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle Margin="1" StrokeThickness="2"
                           Stroke="{DynamicResource AccentButtonBackground}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Width="52" Height="32">
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" />
            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="10,0,0,0"
                     HorizontalAlignment="Left" Fill="{DynamicResource TextFillColorSecondaryBrush}">
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentButtonBackground}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentButtonForeground}" />
              <Setter TargetName="Thumb" Property="RenderTransform">
                <Setter.Value><TranslateTransform X="20" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="14" />
              <Setter TargetName="Thumb" Property="Height" Value="14" />
              <Setter TargetName="Thumb" Property="Margin" Value="9,0,0,0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Thumb" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
