        </DrawingGroup.Children>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="12" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>

  <Style x:Key="InstallerWindowStyle" TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
  </Style>

  <Style x:Key="InstallerConfirmationStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="InstallerPrimaryButtonStyle" TargetType="Button"
         BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="100" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
