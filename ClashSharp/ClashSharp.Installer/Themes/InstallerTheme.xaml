            <GeometryDrawing.Brush>
              <LinearGradientBrush MappingMode="Absolute"
                                   StartPoint="307,188"
                                   EndPoint="721,842">
                <GradientStop Offset="0" Color="#0C7428" />
                <GradientStop Offset="0.48" Color="#0B7026" />
                <GradientStop Offset="1" Color="#0A6822" />
