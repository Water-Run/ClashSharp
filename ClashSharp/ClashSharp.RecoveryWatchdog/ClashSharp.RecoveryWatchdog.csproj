<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ClashSharp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ClashSharpFormalInstallerComponent)'=='true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ClashSharp\Service\WindowsProxyMutationJournal.cs" Link="Service\WindowsProxyMutationJournal.cs" />
    <Compile Include="..\ClashSharp\Service\WindowsProxyOwnershipRestorer.cs" Link="Service\WindowsProxyOwnershipRestorer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClashSharp.Tests" />
  </ItemGroup>

  <Target Name="ValidateFormalInstallerComponentPublish"
          AfterTargets="Publish"
          Condition="'$(ClashSharpFormalInstallerComponent)'=='true'">
    <ItemGroup>
      <_UnexpectedInstallerComponentFile Include="$(PublishDir)**\*"
                                         Exclude="$(PublishDir)ClashSharp.RecoveryWatchdog.exe" />
    </ItemGroup>
    <Error Condition="!Exists('$(PublishDir)ClashSharp.RecoveryWatchdog.exe')"
           Text="Formal Installer watchdog publish is missing its self-contained executable." />
    <Error Condition="'@(_UnexpectedInstallerComponentFile)'!=''"
           Text="Formal Installer watchdog publish contains sidecars: @(_UnexpectedInstallerComponentFile, ', ')." />
  </Target>
</Project>
