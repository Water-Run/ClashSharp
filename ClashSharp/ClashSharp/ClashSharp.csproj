<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>ClashSharp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="View\Connections.xaml" />
    <None Remove="View\Links.xaml" />
    <None Remove="View\MasterControl.xaml" />
    <None Remove="View\Profiles.xaml" />
    <None Remove="View\Proxies.xaml" />
    <None Remove="View\Logs.xaml" />
    <None Remove="View\About.xaml" />
    <None Remove="View\Rules.xaml" />
    <None Remove="View\Settings.xaml" />
    <None Remove="View\Statistics.xaml" />
    <None Remove="View\Triggers.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="themes\Generic.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\Logo.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Flags\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Tray\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Tray\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Binaries\mihomo.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Binaries\mihomo.exe</TargetPath>
    </Content>
    <Content Include="Binaries\mihomo-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Binaries\mihomo-LICENSE.txt</TargetPath>
    </Content>
    <Content Include="Binaries\mihomo-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Binaries\mihomo-NOTICE.txt</TargetPath>
    </Content>
    <Content Include="Binaries\mihomo-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Binaries\mihomo-manifest.json</TargetPath>
    </Content>
    <Content Include="Binaries\GeoData\**\*" Condition="Exists('Binaries\GeoData\manifest.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Binaries\GeoData\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(ClashSharpInstallerServiceRoot)'!='' and '$(ClashSharpInstallerWatchdogRoot)'!=''">
    <Content Include="$(ClashSharpInstallerServiceRoot)\**\*">
      <Link>Binaries\Service\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Binaries\Service\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="$(ClashSharpInstallerWatchdogRoot)\ClashSharp.RecoveryWatchdog.exe">
      <Link>ClashSharp.RecoveryWatchdog.exe</Link>
      <TargetPath>ClashSharp.RecoveryWatchdog.exe</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClashSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ClashSharp.RecoveryWatchdog\RecoveryWatchdogProtocol.cs" Link="Service\RecoveryWatchdogProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClashSharp.Application\ClashSharp.Application.csproj" />
    <ProjectReference Include="..\ClashSharp.Core\ClashSharp.Core.csproj" />
    <ProjectReference Include="..\ClashSharp.Infrastructure\ClashSharp.Infrastructure.csproj" />
    <ProjectReference Include="..\ClashSharp.MihomoService\ClashSharp.MihomoService.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ClashSharp.RecoveryWatchdog\ClashSharp.RecoveryWatchdog.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <Target Name="ValidateInstallerPackageContent" BeforeTargets="PrepareForBuild" Condition="'$(GenerateAppxPackageOnBuild)'=='true'">
    <Error Condition="'$(ClashSharpInstallerServiceRoot)'=='' or '$(ClashSharpInstallerWatchdogRoot)'==''" Text="Formal MSIX packaging must provide fresh Installer component staging roots." />
    <Error Condition="!Exists('$(ClashSharpInstallerServiceRoot)\ClashSharp.MihomoService.exe')" Text="Installer service staging is missing ClashSharp.MihomoService.exe." />
    <Error Condition="!Exists('$(ClashSharpInstallerWatchdogRoot)\ClashSharp.RecoveryWatchdog.exe')" Text="Installer watchdog staging is missing ClashSharp.RecoveryWatchdog.exe." />
    <Error Condition="!Exists('Binaries\mihomo.exe')" Text="MSIX content is missing Binaries\mihomo.exe." />
    <Error Condition="!Exists('Binaries\mihomo-LICENSE.txt')" Text="MSIX content is missing the pinned mihomo license." />
    <Error Condition="!Exists('Binaries\mihomo-NOTICE.txt')" Text="MSIX content is missing the pinned mihomo notice." />
    <Error Condition="!Exists('Binaries\mihomo-manifest.json')" Text="MSIX content is missing the pinned mihomo manifest." />
    <Error Condition="!Exists('Binaries\GeoData\manifest.json')" Text="MSIX content is missing the exact GeoData manifest." />
    <Error Condition="!Exists('Binaries\GeoData\Country.mmdb')" Text="MSIX content is missing Country.mmdb." />
    <Error Condition="!Exists('Binaries\GeoData\GeoIP.dat')" Text="MSIX content is missing GeoIP.dat." />
    <Error Condition="!Exists('Binaries\GeoData\GeoSite.dat')" Text="MSIX content is missing GeoSite.dat." />
    <Error Condition="!Exists('Binaries\GeoData\ASN.mmdb')" Text="MSIX content is missing ASN.mmdb." />
  </Target>

  <Target Name="CopyRecoveryWatchdog" AfterTargets="Build" Condition="'$(DesignTimeBuild)'!='true' and '$(GenerateAppxPackageOnBuild)'!='true'">
    <ItemGroup>
      <RecoveryWatchdogFiles Include="..\ClashSharp.RecoveryWatchdog\bin\$(Platform)\$(Configuration)\net10.0-windows\win-x64\ClashSharp.RecoveryWatchdog.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RecoveryWatchdogFiles)"
      DestinationFiles="@(RecoveryWatchdogFiles->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(RecoveryWatchdogFiles)'!=''" />
  </Target>

  <Target Name="CopyMihomoServiceHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)'!='true' and '$(GenerateAppxPackageOnBuild)'!='true'">
    <ItemGroup>
      <MihomoServiceHostFiles Include="..\ClashSharp.MihomoService\bin\$(Platform)\$(Configuration)\$(TargetFramework)\win-x64\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(MihomoServiceHostFiles)"
      DestinationFiles="@(MihomoServiceHostFiles->'$(OutDir)Binaries\Service\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(MihomoServiceHostFiles)'!=''" />
  </Target>

  <ItemGroup>
    <Page Update="View\Connections.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Links.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\MasterControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Profiles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Proxies.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Logs.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\About.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Rules.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Settings.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Statistics.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="View\Triggers.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Update="Themes\Generic.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <TieredPGO>true</TieredPGO>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
  </PropertyGroup>
</Project>
