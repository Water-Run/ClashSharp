<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Statistics"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:ClashSharp.Components"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:FractionToLengthConverter x:Key="FractionToLengthConverter" />

        <Style x:Key="StatisticsKpiIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatisticsRankBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- One ranked row: label and value on the first line, a single-hue share bar below. -->
        <DataTemplate x:Key="StatisticsTrafficRankTemplate">
            <Grid Padding="0,8" ColumnSpacing="12" ToolTipService.ToolTip="{Binding TransferDisplay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SharePercent}" Style="{StaticResource StatisticsRankBarStyle}" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        Background="Transparent"
        Padding="{StaticResource ClashPagePadding}"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="DescriptionText" Text="{Binding DescriptionText}" Style="{StaticResource ClashPageHeaderDescriptionTextBlockStyle}" />
                </StackPanel>
                <Button x:Name="RefreshStatisticsButton" Grid.Column="1" VerticalAlignment="Top"
                        IsEnabled="{Binding CanRefresh}" Click="RefreshStatisticsButton_Click" AutomationProperties.Name="{Binding RefreshText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{Binding RefreshText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{Binding HasLoadError}" IsClosable="False" Severity="Error" Message="{Binding LoadErrorText}" />

            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="20">
                <ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="{Binding IsLoading}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="{Binding LoadingText}" />
                <TextBlock Text="{Binding StatusText}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- Headline stat tiles: a label, one large value and a short context caption, no chart. -->
            <Grid x:Name="SummaryCards" ColumnSpacing="12" RowSpacing="12" SizeChanged="SummaryCards_SizeChanged"
                  Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource ClashSurfaceCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AB;" Style="{StaticResource StatisticsKpiIconStyle}" />
                            <TextBlock x:Name="TotalStatisticsTitleText" Text="{Binding TrafficKpiTitleText}" Style="{StaticResource ClashStatLabelTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="TotalTransferValueText" Text="{Binding TotalTransferValueText}" Style="{StaticResource ClashStatValueTextBlockStyle}" />
                        <TextBlock x:Name="TotalTrafficText" Text="{Binding TotalTrafficText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Style="{StaticResource ClashSurfaceCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource StatisticsKpiIconStyle}" />
                            <TextBlock Text="{Binding ConnectionsKpiTitleText}" Style="{StaticResource ClashStatLabelTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ConnectionCountValueText" Text="{Binding ConnectionCountValueText}" Style="{StaticResource ClashStatValueTextBlockStyle}" />
                        <TextBlock x:Name="SnapshotStatisticText" Text="{Binding SnapshotStatisticText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2" Style="{StaticResource ClashSurfaceCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D4;" Style="{StaticResource StatisticsKpiIconStyle}" />
                            <TextBlock Text="{Binding NodesKpiTitleText}" Style="{StaticResource ClashStatLabelTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="NodeCountValueText" Text="{Binding NodeCountValueText}" Style="{StaticResource ClashStatValueTextBlockStyle}" />
                        <TextBlock x:Name="NodeHealthText" Text="{Binding NodeHealthText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="3" Style="{StaticResource ClashSurfaceCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" Style="{StaticResource StatisticsKpiIconStyle}" />
                            <TextBlock Text="{Binding ProfilesKpiTitleText}" Style="{StaticResource ClashStatLabelTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ProfileCountValueText" Text="{Binding ProfileCountValueText}" Style="{StaticResource ClashStatValueTextBlockStyle}" />
                        <TextBlock Text="{Binding ProfilesKpiCaptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Recent traffic: one accent series, so the title names it and no legend is drawn. -->
            <Grid x:Name="DailyChartCard" Style="{StaticResource ClashSurfaceCardStyle}" RowSpacing="12"
                  Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ByDateTitleText" Text="{Binding DailyChartTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="{Binding DailyChartRangeText}" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding HasDailyChartData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DailyChartPeakText}" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                    <Grid Grid.Row="1">
                        <!-- Recessive guides: the peak line on top and the baseline the columns stand on. -->
                        <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Border Height="1" VerticalAlignment="Top" Margin="0,148,0,0" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                        <ItemsRepeater x:Name="DailyTrafficChart" ItemsSource="{Binding DailyChartBars}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="14" MinItemWidth="16" MinColumnSpacing="0" MinRowSpacing="0"
                                                   ItemsStretch="Fill" Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTipService.ToolTip="{Binding AccessibleText}"
                                          AutomationProperties.Name="{Binding AccessibleText}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="148" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border VerticalAlignment="Bottom" MaxWidth="28" Margin="3,0"
                                                Height="{Binding Fraction, Converter={StaticResource FractionToLengthConverter}, ConverterParameter=148}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4,4,0,0" />
                                        <TextBlock Grid.Row="1" Text="{Binding DayLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8" Padding="0,24" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoDailyChartData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE9D2;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding NoDailyChartText}" Style="{ThemeResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="BreakdownCards" ColumnSpacing="12" RowDefinitions="Auto" SizeChanged="StatisticsCards_SizeChanged"
                  Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Style="{StaticResource ClashSurfaceCardStyle}" Padding="20,16,20,12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ByProfileTitleText" Text="{Binding ByProfileTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding NoProfileTrafficText}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"
                                   Visibility="{Binding HasNoProfileTraffic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl x:Name="ProfileTrafficList" ItemsSource="{Binding ProfileTrafficRows}" ItemTemplate="{StaticResource StatisticsTrafficRankTemplate}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Style="{StaticResource ClashSurfaceCardStyle}" Padding="20,16,20,12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ByNodeTitleText" Text="{Binding ByNodeTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding NoNodeTrafficText}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"
                                   Visibility="{Binding HasNoNodeTraffic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl x:Name="NodeTrafficList" ItemsSource="{Binding NodeTrafficRows}" ItemTemplate="{StaticResource StatisticsTrafficRankTemplate}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2" Style="{StaticResource ClashSurfaceCardStyle}" Padding="20,16,20,12">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ByRuleTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" Text="{Binding RuleStatisticText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding NoRuleHitsText}" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,4,0,8"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoRuleHits, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl x:Name="RuleHitList" ItemsSource="{Binding RuleHitRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Label}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding HitCountDisplay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SharePercent}" Style="{StaticResource StatisticsRankBarStyle}" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <components:SettingRow x:Name="LogsShortcutRow" Icon="&#xE7C3;" Title="{Binding LogsShortcutTitleText}" Description="{Binding LogsShortcutDescriptionText}">
                <components:SettingRow.ActionContent>
                    <Button x:Name="OpenLogsButton" Command="{Binding OpenLogsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="OpenLogsButtonText" Text="{Binding OpenLogsText}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </StackPanel>
                    </Button>
                </components:SettingRow.ActionContent>
            </components:SettingRow>
        </StackPanel>
    </ScrollViewer>
</Page>
