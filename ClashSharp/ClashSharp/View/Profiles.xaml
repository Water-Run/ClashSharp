<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Profiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PageStatusSeverityConverter x:Key="PageStatusSeverityConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource ClashPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="DescriptionText" Text="{Binding DescriptionText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SubscriptionImportName" Header="{Binding ImportNameText}" Text="{Binding SubscriptionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}" />
            <TextBox x:Name="SubscriptionImportUrl" Grid.Column="1" Header="{Binding ImportSubscriptionText}" PlaceholderText="{Binding ImportUrlPlaceholderText}" Text="{Binding SubscriptionUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}" />
            <Button x:Name="ImportSubscriptionButton" Grid.Column="2" Content="{Binding ImportActionText}" VerticalAlignment="Bottom" IsEnabled="{Binding CanImport}" Click="ImportSubscriptionButton_Click" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="{Binding IsImporting}" />
                <TextBlock Text="{Binding ImportProgressText}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <CommandBar Style="{StaticResource ClashPageCommandBarStyle}" x:Name="ProfileCommands" Grid.Row="2" Margin="0,12,0,0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="ImportProfileButton" Label="{Binding ImportProfileText}" Click="ImportProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ValidateProfileButton" IsEnabled="{Binding HasSelectedProfile}" Label="{Binding ValidateProfileText}" Click="ValidateProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SetActiveProfileButton" IsEnabled="{Binding HasSelectedProfile}" Label="{Binding SetActiveProfileText}" Click="SetActiveProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="RenameProfileButton" IsEnabled="{Binding CanModifySelectedProfile}" Label="{Binding RenameProfileText}" Click="RenameProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteProfileButton" IsEnabled="{Binding CanModifySelectedProfile}" Label="{Binding DeleteProfileText}" Click="DeleteProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ProfileHistoryButton" IsEnabled="{Binding HasSelectedProfile}" Label="{Binding ProfileHistoryText}" Click="ProfileHistoryButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar Grid.Row="3" Margin="0,12,0,0" IsOpen="{Binding HasStatusText, Mode=OneWay}" IsClosable="False"
                 Severity="{Binding StatusSeverity, Converter={StaticResource PageStatusSeverityConverter}}" Message="{Binding StatusText}"
                 Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}">
            <InfoBar.ActionButton>
                <Button Content="{Binding SetActiveProfileText}" Click="SetActiveProfileButton_Click" Visibility="{Binding CanUseImportedProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource ClashSectionGridStyle}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="CurrentProfileTitleText" Text="{Binding CurrentProfileTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ActiveProfileText" Text="{Binding ActiveProfileText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="5" Margin="0,16,0,0" x:Name="ProfilesList" Style="{StaticResource ClashDataListStyle}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionMode="Single">
            <ListView.Header>
                <Grid Padding="20,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProfileNameColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding NodesColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding RulesColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding UpdatedColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding NameDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NameDisplay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding SourceNameDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SourceNameDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding StatusDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding NodeCount}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding NodeCount}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding RuleCount}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding RuleCount}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding UpdatedAtDisplay}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding UpdatedAtDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
