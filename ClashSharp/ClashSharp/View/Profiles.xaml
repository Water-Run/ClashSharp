<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Profiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PageStatusSeverityConverter x:Key="PageStatusSeverityConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource ClashPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="DescriptionText" Text="{Binding DescriptionText}" Style="{StaticResource ClashPageHeaderDescriptionTextBlockStyle}" />
        </StackPanel>

        <!-- Current profile summary, then the subscription import card directly below it. -->
        <Grid Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource ClashSettingsCardStyle}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8F1;" Style="{StaticResource ClashCardIconStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="2,0,2,0" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentProfileTitleText" Text="{Binding CurrentProfileTitleText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ActiveProfileText" Text="{Binding ActiveProfileText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource ClashSettingsCardStyle}" ColumnSpacing="16" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Glyph="&#xE896;" Style="{StaticResource ClashCardIconStyle}" Margin="2,0,2,0" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="{Binding ImportSubscriptionText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SubscriptionImportUrl" PlaceholderText="{Binding ImportUrlPlaceholderText}" Text="{Binding SubscriptionUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}"
                         AutomationProperties.Name="{Binding ImportSubscriptionText}" />
                <TextBox x:Name="SubscriptionImportName" Grid.Column="1" PlaceholderText="{Binding ImportNameText}" Text="{Binding SubscriptionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}"
                         AutomationProperties.Name="{Binding ImportNameText}" />
                <Button x:Name="ImportSubscriptionButton" Grid.Column="2" Content="{Binding ImportActionText}" MinWidth="96" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanImport}" Click="ImportSubscriptionButton_Click" />
            </Grid>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="{Binding IsImporting}" />
                <TextBlock Text="{Binding ImportProgressText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <CommandBar Style="{StaticResource ClashPageCommandBarStyle}" x:Name="ProfileCommands" Grid.Row="3" Margin="0,16,0,0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="ImportProfileButton" Label="{Binding ImportProfileText}" Click="ImportProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8E5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ValidateProfileButton" IsEnabled="{Binding HasSelectedProfile}" Label="{Binding ValidateProfileText}" Click="ValidateProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SetActiveProfileButton" IsEnabled="{Binding CanActivateSelectedProfile}" Label="{Binding SetActiveProfileText}" Click="SetActiveProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="RenameProfileButton" IsEnabled="{Binding CanModifySelectedProfile}" Label="{Binding RenameProfileText}" Click="RenameProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteProfileButton" IsEnabled="{Binding CanModifySelectedProfile}" Label="{Binding DeleteProfileText}" Click="DeleteProfileButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ProfileHistoryButton" IsEnabled="{Binding HasSelectedProfile}" Label="{Binding ProfileHistoryText}" Click="ProfileHistoryButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar Grid.Row="4" Margin="0,8,0,0" IsOpen="{Binding HasStatusText, Mode=OneWay}" IsClosable="False"
                 Severity="{Binding StatusSeverity, Converter={StaticResource PageStatusSeverityConverter}}" Message="{Binding StatusText}"
                 Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}">
            <InfoBar.ActionButton>
                <Button Content="{Binding SetActiveProfileText}" Click="SetActiveProfileButton_Click" Visibility="{Binding CanUseImportedProfile, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <ListView Grid.Row="5" Margin="0,8,0,0" x:Name="ProfilesList" Style="{StaticResource ClashDataListStyle}" VerticalAlignment="Top" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionMode="Single">
            <ListView.Header>
                <Grid Padding="20,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProfileNameColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding NodesColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding RulesColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding UpdatedColumnText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NameDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NameDisplay}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ClashAccentBadgeStyle}" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveLabelDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding SourceNameDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SourceNameDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding StatusDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding NodeCount}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding NodeCount}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding RuleCount}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding RuleCount}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding UpdatedAtDisplay}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding UpdatedAtDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
