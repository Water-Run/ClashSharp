<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Triggers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="{StaticResource ClashPagePadding}">
        <Grid
            x:Name="TriggerListHost"
            RowSpacing="16"
            Visibility="{Binding IsListing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{Binding DescriptionText}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid Grid.Row="1" Style="{StaticResource ClashCardGridStyle}" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding PageTitleText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{Binding DisabledNoticeText}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding IsDisabledNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Button Grid.Column="1" Click="EnableAllTriggersButton_Click" IsEnabled="{Binding CanEditTriggers}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        <TextBlock Text="{Binding EnableAllText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="DisableAllTriggersButton_Click" IsEnabled="{Binding CanEditTriggers}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="{Binding DisableAllText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Click="OpenTriggerLogsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="{Binding OpenTriggerLogsText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <ProgressRing
                        IsActive="{Binding IsBusy}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding EmptyText}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListView ItemsSource="{Binding TriggerTasks}" SelectionMode="None" IsEnabled="{Binding CanEditTriggers}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource ClashCardGridStyle}" Margin="0,0,0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                Tag="{Binding}"
                                                Toggled="TriggerEnabledToggle_Toggled"
                                                MinWidth="0"
                                                OnContent="{x:Null}"
                                                OffContent="{x:Null}" />
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding ConditionsLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding ConditionsSummary}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding ActionsLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding ActionsSummary}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding LastTriggeredLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding LastTriggeredSummary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Tag="{Binding}" Click="EditTriggerButton_Click"><FontIcon Glyph="&#xE70F;" FontSize="14" /></Button>
                                        <Button Tag="{Binding Id}" Click="MoveTriggerUpButton_Click"><FontIcon Glyph="&#xE70E;" FontSize="14" /></Button>
                                        <Button Tag="{Binding Id}" Click="MoveTriggerDownButton_Click"><FontIcon Glyph="&#xE70D;" FontSize="14" /></Button>
                                        <Button Tag="{Binding Id}" Click="DeleteTriggerButton_Click"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="AddTriggerCardButton_Click"
                        IsEnabled="{Binding CanEditTriggers}">
                        <Grid Style="{StaticResource ClashCardGridStyle}" ColumnSpacing="12" MinHeight="76">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE710;" FontSize="20" Width="28" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AddTriggerText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding AddDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="TriggerEditorHost"
            RowSpacing="16"
            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Click="BackToTriggerListButton_Click" VerticalAlignment="Top" IsEnabled="{Binding CurrentEditor.CanCancel}"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding CurrentEditor.Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="{Binding DescriptionText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CurrentEditor.CanEdit}">
                <StackPanel Spacing="14">
                    <Grid Style="{StaticResource ClashCardGridStyle}" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="{Binding NameText}" Text="{Binding CurrentEditor.Name, Mode=TwoWay}" MaxLength="48" />
                        <ToggleSwitch Grid.Row="1" Header="{Binding EnabledText}" IsOn="{Binding CurrentEditor.IsEnabled, Mode=TwoWay}" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}" />
                        <TextBlock
                            Grid.Row="2"
                            Text="{Binding CurrentEditor.ErrorMessage}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding CurrentEditor.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Grid Style="{StaticResource ClashCardGridStyle}" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ConditionsText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding ConditionDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ChooseTriggerConditionButton_Click"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding CurrentEditor.Conditions}"
                            SelectedItem="{Binding CurrentEditor.SelectedCondition, Mode=TwoWay}"
                            SelectionMode="Single"
                            MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Tag="{Binding}" Click="MoveConditionUpButton_Click"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                                            <Button Tag="{Binding}" Click="MoveConditionDownButton_Click"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                                            <Button Tag="{Binding}" Click="RemoveConditionButton_Click"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <Grid
                                ColumnSpacing="8"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsThresholdVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{Binding ConditionThresholdHeaderText}"
                                    Text="{Binding CurrentEditor.SelectedCondition.ThresholdText, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Bottom"
                                    Text="{Binding CurrentEditor.SelectedCondition.ThresholdUnitText}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ComboBox
                                Header="{Binding ConditionScopeHeaderText}"
                                ItemsSource="{Binding CurrentEditor.TrafficScopeOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding CurrentEditor.SelectedCondition.TrafficScope, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsTrafficScopeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox
                                Header="{Binding WindowSecondsHeaderText}"
                                Text="{Binding CurrentEditor.SelectedCondition.WindowSecondsText, Mode=TwoWay}"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsWindowVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox
                                Header="{Binding NotificationLevelHeaderText}"
                                ItemsSource="{Binding CurrentEditor.NotificationLevelOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding CurrentEditor.SelectedCondition.NotificationLevel, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsNotificationLevelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox
                                Header="{Binding RateDirectionHeaderText}"
                                ItemsSource="{Binding CurrentEditor.RateDirectionOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding CurrentEditor.SelectedCondition.RateDirection, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsRateDirectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox
                                Header="{Binding RuntimeSecondsHeaderText}"
                                Text="{Binding CurrentEditor.SelectedCondition.RuntimeSecondsText, Mode=TwoWay}"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsRuntimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox
                                Header="{Binding ConditionTimeHeaderText}"
                                Text="{Binding CurrentEditor.SelectedCondition.TargetTimeText, Mode=TwoWay}"
                                Visibility="{Binding CurrentEditor.SelectedCondition.IsTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                Text="{Binding CurrentEditor.SelectedCondition.ErrorMessage}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{Binding CurrentEditor.SelectedCondition.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource ClashCardGridStyle}" RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ActionsText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding ActionDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ChooseTriggerActionButton_Click"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding CurrentEditor.Actions}"
                            SelectedItem="{Binding CurrentEditor.SelectedAction, Mode=TwoWay}"
                            SelectionMode="Single"
                            MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Tag="{Binding}" Click="MoveActionUpButton_Click"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                                            <Button Tag="{Binding}" Click="MoveActionDownButton_Click"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                                            <Button Tag="{Binding}" Click="RemoveActionButton_Click"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <ToggleSwitch
                                Header="{Binding BooleanValueHeaderText}"
                                IsOn="{Binding CurrentEditor.SelectedAction.BooleanValue, Mode=TwoWay}"
                                MinWidth="0"
                                OnContent="{x:Null}"
                                OffContent="{x:Null}"
                                Visibility="{Binding CurrentEditor.SelectedAction.IsBooleanVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox
                                Header="{Binding ProxyModeHeaderText}"
                                ItemsSource="{Binding CurrentEditor.ProxyModeOptions}"
                                DisplayMemberPath="Title"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding CurrentEditor.SelectedAction.ProxyMode, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding CurrentEditor.SelectedAction.IsProxyModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox
                                Header="{Binding NotificationMessageHeaderText}"
                                Text="{Binding CurrentEditor.SelectedAction.NotificationMessage, Mode=TwoWay}"
                                Visibility="{Binding CurrentEditor.SelectedAction.IsNotificationMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                Text="{Binding CurrentEditor.SelectedAction.ErrorMessage}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{Binding CurrentEditor.SelectedAction.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <ProgressRing IsActive="{Binding CurrentEditor.IsBusy}" Visibility="{Binding CurrentEditor.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Click="CancelTriggerEditButton_Click" IsEnabled="{Binding CurrentEditor.CanCancel}"><TextBlock Text="{Binding CancelText}" /></Button>
                    <Button Click="SaveTriggerButton_Click" IsEnabled="{Binding CurrentEditor.CanSave}"><TextBlock Text="{Binding SaveText}" /></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
