<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Links"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PageStatusSeverityConverter x:Key="PageStatusSeverityConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource ClashPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="DescriptionText" Text="{Binding DescriptionText}" Style="{StaticResource ClashPageHeaderDescriptionTextBlockStyle}" />
        </StackPanel>

        <CommandBar Style="{StaticResource ClashPageCommandBarStyle}" x:Name="LinkCommands" Grid.Row="1" Margin="0,12,0,0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="AddLinkButton" Label="{Binding AddLinkText}" Click="AddLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CheckLinksButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding CheckLinksText}" Click="CheckLinksButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="UpdateLinksButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding UpdateLinksText}" Click="UpdateLinksButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="EditLinkButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding EditLinkText}" Click="EditLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteLinkButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding DeleteLinkText}" Click="DeleteLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar Grid.Row="2" Margin="0,12,0,0" IsOpen="{Binding HasStatusText, Mode=OneWay}" IsClosable="False"
                 Severity="{Binding StatusSeverity, Converter={StaticResource PageStatusSeverityConverter}}" Message="{Binding StatusText}"
                 Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- Each subscription is its own card; selection keeps the native list indicator for the command bar. -->
        <ListView Grid.Row="3" Margin="0,16,0,0" x:Name="SubscriptionLinksList" ItemsSource="{Binding SubscriptionLinks}" SelectedItem="{Binding SelectedLink, Mode=TwoWay}" SelectionMode="Single"
                  ItemContainerStyle="{StaticResource ClashCardListItemStyle}" Padding="0" VerticalAlignment="Top"
                  Visibility="{Binding HasLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,16" ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Grid.RowSpan="2" Glyph="&#xE71B;" Style="{StaticResource ClashCardIconStyle}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{Binding NameDisplay}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Border Grid.Column="2" Style="{StaticResource ClashNeutralBadgeStyle}" ToolTipService.ToolTip="{Binding StatusDisplay}">
                            <TextBlock Text="{Binding StatusDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding UriDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding UriDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Spacing="6">
                            <TextBlock Text="{Binding UsageDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsagePercent}" AutomationProperties.AccessibilityView="Raw"
                                         Visibility="{Binding HasUsageQuota, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ColumnSpacing="24" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ScheduleDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdatedSummary}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" Margin="0,40,0,0" Padding="24,32" VerticalAlignment="Top"
              Visibility="{Binding HasNoLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE71B;" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{Binding EmptyStateTitleText}" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="EmptyAddLinkButton" Content="{Binding AddLinkText}" Click="AddLinkButton_Click"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" MinWidth="132" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
