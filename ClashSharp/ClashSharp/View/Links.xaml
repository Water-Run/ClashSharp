<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Links"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PageStatusSeverityConverter x:Key="PageStatusSeverityConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource ClashPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="DescriptionText" Text="{Binding DescriptionText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <CommandBar Style="{StaticResource ClashPageCommandBarStyle}" x:Name="LinkCommands" Grid.Row="1" Margin="0,12,0,0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="AddLinkButton" Label="{Binding AddLinkText}" Click="AddLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CheckLinksButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding CheckLinksText}" Click="CheckLinksButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="UpdateLinksButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding UpdateLinksText}" Click="UpdateLinksButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="EditLinkButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding EditLinkText}" Click="EditLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteLinkButton" IsEnabled="{Binding HasSelectedLink}" Label="{Binding DeleteLinkText}" Click="DeleteLinkButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar Grid.Row="2" Margin="0,12,0,0" IsOpen="{Binding HasStatusText, Mode=OneWay}" IsClosable="False"
                 Severity="{Binding StatusSeverity, Converter={StaticResource PageStatusSeverityConverter}}" Message="{Binding StatusText}"
                 Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ListView Grid.Row="3" Margin="0,16,0,0" x:Name="SubscriptionLinksList" Style="{StaticResource ClashDataListStyle}" ItemsSource="{Binding SubscriptionLinks}" SelectedItem="{Binding SelectedLink, Mode=TwoWay}" SelectionMode="Single"
                  Visibility="{Binding HasLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="4,10" Spacing="6">
                        <TextBlock Text="{Binding NameDisplay}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding UriDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding UriDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusDisplay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid ColumnSpacing="20" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ScheduleDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdatedSummary}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Text="{Binding UsageDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExpiryDisplay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource ClashCardGridStyle}" Padding="32" VerticalAlignment="Top"
              Visibility="{Binding HasNoLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE71B;" FontSize="32" HorizontalAlignment="Left"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="EmptyAddLinkButton" Content="{Binding AddLinkText}" Click="AddLinkButton_Click"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
