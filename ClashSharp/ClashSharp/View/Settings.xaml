<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:ClashSharp.Components"
    xmlns:converters="using:ClashSharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <converters:PageStatusSeverityConverter x:Key="PageStatusSeverityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Background="Transparent"
            IsEnabled="{Binding IsPreferenceInputEnabled}"
            Padding="{StaticResource ClashPagePadding}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1040" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="SettingsContentPanel" Spacing="{StaticResource ClashSettingsCardSpacing}" Style="{StaticResource ClashReadingPagePanelStyle}">
                    <TextBlock x:Name="PageTitleText" Text="{Binding PageTitleText}"
                               Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    <StackPanel x:Name="ApplicationRecoveryPanel" Spacing="6"
                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <InfoBar Title="{Binding Title}" Message="{Binding Description}"
                                 Severity="Warning" IsClosable="False" IsOpen="{Binding IsVisible, Mode=OneWay}"
                                 AutomationProperties.AutomationId="SettingsRecoveryNotice" />
                        <ItemsControl ItemsSource="{Binding Issues}" IsEnabled="{Binding CanRetry}"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.AutomationId="SettingsRecoveryIssues">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Margin="12,0" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <HyperlinkButton Grid.Column="1" Content="{Binding RetryText}" Tag="{Binding}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Click="RetryApplication_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="12,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <InfoBar
                        Message="{Binding OperationErrorText}"
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{Binding HasOperationError, Mode=OneWay}"
                        Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <InfoBar.ActionButton>
                            <Button Content="{Binding RetrySettingsResetText}"
                                    Click="RetryRuntimeSettingsReset_Click"
                                    Visibility="{Binding CanRetrySettingsReset, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        Message="{Binding DataReplacementWarningText}"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{Binding HasDataReplacementWarning, Mode=OneWay}"
                        Visibility="{Binding HasDataReplacementWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <InfoBar
                        x:Name="SettingsRestartRequiredNoticeText"
                        Title="{Binding RestartRequiredTitleText}"
                        Message="{Binding RestartRequiredNoticeText}"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{Binding HasRestartRequiredSettings, Mode=OneWay}"
                        Visibility="{Binding HasRestartRequiredSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <InfoBar.ActionButton>
                            <Button x:Name="ApplyRestartRequiredButton"
                                    Content="{Binding RestartApplicationText}"
                                    Command="{Binding RestartApplicationCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock x:Name="LanguageSectionTitleText" Text="{Binding LanguageSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" Margin="1,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="LanguageRow" Icon="&#xF2B7;" Title="{Binding LanguageTitleText}" Description="{Binding LanguageDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="LanguageBox" Width="180" ItemsSource="{Binding DisplayLanguageOptions}" SelectedIndex="{Binding DisplayLanguageIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="AppThemeModeRow" Icon="&#xE771;" Title="{Binding AppThemeModeTitleText}" Description="{Binding AppThemeModeDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="AppThemeModeBox" Width="180" ItemsSource="{Binding AppThemeModeOptions}" SelectedIndex="{Binding AppThemeModeIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="AppAccentColorRow" Icon="&#xE790;" Title="{Binding AppAccentColorTitleText}" Description="{Binding AppAccentColorDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox x:Name="AppAccentColorModeBox" MinWidth="180" ItemsSource="{Binding AppAccentColorModeOptions}" SelectedIndex="{Binding AppAccentColorModeIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                                <Button
                                    x:Name="AppAccentColorSwatchButton"
                                    Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    Padding="4"
                                    Click="AppAccentColorSwatchButton_Click"
                                    AutomationProperties.Name="{Binding AppAccentColorPickText}"
                                    ToolTipService.ToolTip="{Binding AppAccentColorPickText}"
                                    Visibility="{Binding IsCustomAccentColorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{Binding AppAccentColorValue, Converter={StaticResource HexColorBrushConverter}}" />
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="CloseBehaviorModeRow" Icon="&#xE7C4;" Title="{Binding CloseBehaviorModeTitleText}" Description="{Binding CloseBehaviorModeDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="CloseBehaviorModeBox" Width="220" ItemsSource="{Binding CloseBehaviorModeOptions}" SelectedIndex="{Binding CloseBehaviorModeIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ApplicationLifecycleRow" Icon="&#xE7E8;" Title="{Binding ApplicationLifecycleTitleText}" Description="{Binding ApplicationLifecycleDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="RestartApplicationButton" Command="{Binding RestartApplicationCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                                        <TextBlock Text="{Binding RestartApplicationText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExitApplicationButton" Command="{Binding ExitApplicationCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                                        <TextBlock Text="{Binding ExitApplicationText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <HyperlinkButton x:Name="ResetBasicSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetBasicSettingsButton_Click" />

                    <TextBlock Text="{Binding UnitsSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow Icon="&#xEDA2;" Title="{Binding DataUnitStyleTitleText}" Description="{Binding DataUnitStyleDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="DataUnitStyleBox" Width="240" ItemsSource="{Binding DataUnitStyleOptions}" SelectedIndex="{Binding DataUnitStyleIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <components:SettingRow Icon="&#xEC4A;" Title="{Binding RateUnitTitleText}" Description="{Binding RateUnitDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="RateUnitBox" Width="240" ItemsSource="{Binding RateUnitOptions}" SelectedIndex="{Binding RateUnitIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <components:SettingRow Icon="&#xE823;" Title="{Binding ClockFormatTitleText}" Description="{Binding ClockFormatDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="ClockFormatBox" Width="240" ItemsSource="{Binding ClockFormatOptions}" SelectedIndex="{Binding ClockFormatIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <HyperlinkButton x:Name="ResetUnitsSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right"
                                     Margin="0,0,8,0" Padding="0" Click="ResetUnitsSettingsButton_Click" />
                    <TextBlock x:Name="StartupSectionTitleText" Text="{Binding StartupSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="LaunchAtStartupRow" Icon="&#xE768;" Title="{Binding LaunchAtStartupTitleText}" Description="{Binding LaunchAtStartupDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="LaunchAtStartupToggle" MinWidth="0" IsOn="{Binding LaunchAtStartupEnabled, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="StartupConflictCheckRow" Icon="&#xE9D9;" Title="{Binding StartupConflictCheckTitleText}" Description="{Binding StartupConflictCheckDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="StartupConflictCheckToggle" MinWidth="0" IsOn="{Binding StartupConflictCheckEnabled, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                                <Button x:Name="CheckStartupConflictsButton" Click="CheckStartupConflictsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="{Binding CheckStartupConflictsNowText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ShowStartupGuideRow" Icon="&#xE7BE;" Title="{Binding StartupGuideTitleText}" Description="{Binding StartupGuideDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="ShowStartupGuideToggle" MinWidth="0" IsOn="{Binding ShowStartupGuideOnStartup, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                                <Button x:Name="ShowStartupPromptButton" Click="ShowStartupPromptButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                        <TextBlock Text="{Binding StartupGuideShowNowText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="StartupBehaviorModeRow" Icon="&#xE945;" Title="{Binding StartupBehaviorModeTitleText}" Description="{Binding StartupBehaviorModeDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="StartupBehaviorModeBox" Width="180" ItemsSource="{Binding StartupBehaviorModeOptions}" SelectedIndex="{Binding StartupBehaviorModeIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <HyperlinkButton x:Name="ResetStartupSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetStartupSettingsButton_Click" />

                    <TextBlock x:Name="ProxySectionTitleText" Text="{Binding ProxySectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="TransparentProxyRow" Icon="&#xE839;" Title="{Binding TransparentProxyTitleText}" Description="{Binding TransparentProxyDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="TransparentProxyToggle" MinWidth="0" IsEnabled="{Binding CanToggleTransparentProxy}" IsOn="{Binding TransparentProxyEnabled, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="TransparentProxyServiceRow" Icon="&#xE912;" Title="{Binding TransparentProxyServiceTitleText}" Description="{Binding TransparentProxyServiceDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="MihomoServiceStatusText" Text="{Binding MihomoServiceStatusText}" ToolTipService.ToolTip="{Binding MihomoServiceDiagnosticText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="280" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="MixedPortRow" Icon="&#xE968;" Title="{Binding MixedPortTitleText}" Description="{Binding MixedPortDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <NumberBox x:Name="MixedPortBox" Width="140" Minimum="1" Maximum="65535" Value="{Binding MixedPortValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ConnectionTestUrlRow" Icon="&#xE916;" Title="{Binding ConnectionTestUrlTitleText}" Description="{Binding ConnectionTestUrlDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ConnectionTestUrlSummaryText}" Width="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="EditConnectionTestUrlsButton" Click="EditConnectionTestUrlsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="{Binding EditText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ConnectionTestButton" Click="ConnectionTestButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="{Binding TestText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                        <components:SettingRow.DetailContent>
                            <StackPanel x:Name="ConnectionTestFeedback" Margin="0,16,0,0" Spacing="12" Visibility="Collapsed">
                                <StackPanel x:Name="ConnectionTestBusyPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                    <ProgressRing Width="20" Height="20" MinWidth="0" MinHeight="0"
                                                  IsActive="{Binding IsConnectionTestRunning, Mode=OneWay}" />
                                    <TextBlock Text="{Binding ConnectionTestRunningText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="ConnectionTestResults" HorizontalAlignment="Stretch"
                                            AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </components:SettingRow.DetailContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ConnectionSamplingRow" Icon="&#xE9D2;" Title="{Binding ConnectionSamplingTitleText}" Description="{Binding ConnectionSamplingDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="ConnectionSamplingToggle" MinWidth="0" IsOn="{Binding ConnectionSamplingEnabled, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="SamplingIntervalRow" Icon="&#xE121;" Title="{Binding SamplingIntervalTitleText}" Description="{Binding SamplingIntervalDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <NumberBox x:Name="ConnectionSamplingIntervalBox" Width="140" Minimum="3" Maximum="300" Value="{Binding ConnectionSamplingIntervalSecondsValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <HyperlinkButton x:Name="ResetProxySettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetProxySettingsButton_Click" />

                    <TextBlock x:Name="WindowsNativeSectionTitleText" Text="{Binding WindowsNativeSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="StartupRestoreFallbackRow" Icon="&#xE777;" Title="{Binding StartupRestoreFallbackTitleText}" Description="{Binding StartupRestoreFallbackDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="{Binding IsCheckingStartupRestoreFallback}"
                                              Visibility="{Binding IsCheckingStartupRestoreFallback, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="StartupRestoreFallbackStatusText" Text="{Binding StartupRestoreFallbackStatusText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RegisterStartupRestoreFallbackButton" Click="RegisterStartupRestoreFallbackButton_Click" IsEnabled="{Binding CanRegisterStartupRestoreFallback}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                                        <TextBlock Text="{Binding RegisterText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetectStartupRestoreFallbackButton" Click="DetectStartupRestoreFallbackButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="{Binding DetectText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RemoveStartupRestoreFallbackRegistrationButton" Click="RemoveStartupRestoreFallbackRegistrationButton_Click" IsEnabled="{Binding CanRemoveStartupRestoreFallbackRegistration}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="{Binding RemoveRegistrationText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                        <components:SettingRow.DetailContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                        Visibility="{Binding HasStartupRestoreFallbackCheckResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw"
                                          Visibility="{Binding IsStartupRestoreFallbackRegistered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw"
                                          Visibility="{Binding IsStartupRestoreFallbackNotRegistered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding StartupRestoreFallbackCheckResultText}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </components:SettingRow.DetailContent>
                    </components:SettingRow>

                    <Grid x:Name="WindowsNativeRepairCard" Style="{StaticResource ClashSettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE90F;" Style="{StaticResource ClashCardIconStyle}" Margin="2,0,18,0" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="WindowsNativeTitleText" Text="{Binding WindowsNativeTitleText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="WindowsNativeDescriptionText" Text="{Binding WindowsNativeDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Click="OpenNetworkRepairButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock x:Name="OpenNetworkRepairText" Text="{Binding OpenText}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <components:SettingRow x:Name="CheckStaleProxyRow" Icon="&#xE721;" Title="{Binding CheckStaleProxyTitleText}" Description="{Binding CheckStaleProxyDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="CheckStaleProxyToggle" MinWidth="0" IsOn="{Binding CheckStaleProxyOnStartup, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="RestoreProxyOnExitRow" Icon="&#xE7A7;" Title="{Binding RestoreProxyOnExitTitleText}" Description="{Binding RestoreProxyOnExitDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="RestoreProxyOnExitToggle" MinWidth="0" IsOn="{Binding RestoreProxyOnExit, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <HyperlinkButton x:Name="ResetWindowsNativeSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetWindowsNativeSettingsButton_Click" />

                    <TextBlock x:Name="NotificationSectionTitleText" Text="{Binding NotificationSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="NotificationEnabledRow" Icon="&#xEA8F;" Title="{Binding NotificationEnabledTitleText}" Description="{Binding NotificationEnabledDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="NotificationEnabledToggle" MinWidth="0" IsOn="{Binding NotificationEnabled, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="NotificationLevelRow" Icon="&#xE8C9;" Title="{Binding NotificationTitleText}" Description="{Binding NotificationDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="NotificationLevelBox" Width="180" ItemsSource="{Binding NotificationLevelOptions}" SelectedIndex="{Binding NotificationLevelIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <!-- What each notification level delivers, so the preset is a transparent configuration. -->
                    <Expander x:Name="NotificationContentExpander"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="58,8,16,12"
                              AutomationProperties.Name="{Binding NotificationMatrixTitleText}">
                        <Expander.Header>
                            <Grid Padding="0,12" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8FD;" Style="{StaticResource ClashCardIconStyle}" Margin="1,0,0,0" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NotificationMatrixTitleText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding NotificationMatrixDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Grid x:Name="NotificationContentMatrix" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding NotificationCriticalOnlyText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding NotificationDefaultText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding NotificationMoreText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,8">
                                <TextBlock Text="{Binding NotificationMatrixCriticalTitleText}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NotificationMatrixCriticalDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Row="1" Grid.Column="1" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="1" Grid.Column="2" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="1" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Row="2" Spacing="2" Margin="0,8,0,8">
                                <TextBlock Text="{Binding NotificationMatrixImportantTitleText}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NotificationMatrixImportantDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="2" Grid.Column="2" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="2" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <Border Grid.Row="2" Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Row="3" Spacing="2" Margin="0,8,0,8">
                                <TextBlock Text="{Binding NotificationMatrixRoutineTitleText}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NotificationMatrixRoutineDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="3" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Row="4" Spacing="2" Margin="0,8,0,8">
                                <TextBlock Text="{Binding NotificationMatrixTriggerTitleText}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NotificationMatrixTriggerDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="4" Grid.Column="2" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon Grid.Row="4" Grid.Column="3" Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Expander>
                    <HyperlinkButton x:Name="ResetNotificationSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetNotificationSettingsButton_Click" />

                    <TextBlock x:Name="TriggerSectionTitleText" Text="{Binding TriggerSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="TriggersEnabledRow" Icon="&#xE7C1;" Title="{Binding TriggersEnabledTitleText}" Description="{Binding TriggersEnabledDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="TriggersEnabledToggle" MinWidth="0" IsOn="{Binding TriggersEnabled, Mode=OneWay}" OnContent="{x:Null}" OffContent="{x:Null}" Toggled="PreferenceToggle_Toggled" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="TriggerNotificationsEnabledRow" Icon="&#xEA8F;" Title="{Binding TriggerNotificationsEnabledTitleText}" Description="{Binding TriggerNotificationsEnabledDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="TriggerNotificationsEnabledToggle" MinWidth="0" IsOn="{Binding TriggerNotificationsEnabled, Mode=OneWay}" OnContent="{x:Null}" OffContent="{x:Null}" Toggled="PreferenceToggle_Toggled" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <HyperlinkButton x:Name="ResetTriggerSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetTriggerSettingsButton_Click" />

                    <TextBlock x:Name="TraySectionTitleText" Text="{Binding TraySectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="TrayUseMonochromeInactiveIconRow" Icon="&#xE7F4;" Title="{Binding TrayUseMonochromeInactiveIconTitleText}" Description="{Binding TrayUseMonochromeInactiveIconDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ToggleSwitch x:Name="TrayUseMonochromeInactiveIconToggle" MinWidth="0" IsOn="{Binding TrayUseMonochromeInactiveIcon, Mode=OneWay}" OnContent="{x:Null}" OffContent="{x:Null}" Toggled="PreferenceToggle_Toggled" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="TrayVisibleFeaturesRow" Icon="&#xE8FD;" Title="{Binding TrayVisibleFeaturesTitleText}" Description="{Binding TrayVisibleFeaturesDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TrayVisibleFeatureSummaryText}" MinWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="EditTrayVisibleFeaturesButton" Click="EditTrayVisibleFeaturesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="{Binding EditText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <HyperlinkButton x:Name="ResetTraySettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetTraySettingsButton_Click" />

                    <TextBlock x:Name="MainlandChinaSectionTitleText" Text="{Binding MainlandChinaSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="MainlandChinaDisplayRow" Icon="&#xE909;" Title="{Binding MainlandChinaDisplayTitleText}" Description="{Binding MainlandChinaDisplayDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <ComboBox x:Name="MainlandChinaFeatureModeBox" Width="280" HorizontalContentAlignment="Stretch"
                                      ItemsSource="{Binding MainlandChinaFeatureModeOptions}"
                                      SelectedIndex="{Binding MainlandChinaFeatureModeIndex, Mode=OneWay}" SelectionChanged="PreferenceCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="MainlandChinaUrlBlockingRow" Icon="&#xEA18;" Title="{Binding MainlandChinaUrlBlockingTitleText}" Description="{Binding MainlandChinaUrlBlockingDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="MainlandChinaUrlBlockingToggle" MinWidth="0" IsOn="{Binding MainlandChinaUrlBlockingEnabled, Mode=OneWay}" Toggled="PreferenceToggle_Toggled" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                    <HyperlinkButton x:Name="ResetMainlandChinaSettingsLink" Content="{Binding ResetGroupToDefaultsText}" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="0" Click="ResetMainlandChinaSettingsButton_Click" />

                    <ContentControl x:Name="McpPanel" IsEnabled="{Binding IsInputEnabled}" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource ClashSettingsCardSpacing}">
                            <TextBlock Text="{Binding TitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{Binding DescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,8" />
                            <components:SettingRow Icon="&#xE943;" Title="{Binding EnabledText}" Description="{Binding EnabledDescriptionText}">
                                <components:SettingRow.ActionContent>
                                    <ToggleSwitch x:Name="McpEnabledToggle" IsOn="{Binding Enabled, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}"
                                                  MinWidth="0" AutomationProperties.Name="{Binding EnabledText}" />
                                </components:SettingRow.ActionContent>
                            </components:SettingRow>
                            <components:SettingRow Icon="&#xE968;" Title="{Binding PortText}" Description="{Binding PortDescriptionText}">
                                <components:SettingRow.ActionContent>
                                    <NumberBox x:Name="McpPortBox" Value="{Binding Port, Mode=TwoWay}" Minimum="1024" Maximum="65535"
                                               SmallChange="1" SpinButtonPlacementMode="Compact" Width="160"
                                               AutomationProperties.Name="{Binding PortText}" />
                                </components:SettingRow.ActionContent>
                            </components:SettingRow>
                            <!-- Permissions use the settings-card header geometry so the group reads as one list. -->
                            <Expander x:Name="McpPermissionsExpander"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="58,12,16,8"
                                      AutomationProperties.Name="{Binding PermissionsText}">
                                <Expander.Header>
                                    <Grid Padding="0,12" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEA18;" Style="{StaticResource ClashCardIconStyle}" Margin="1,0,0,0" AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PermissionsText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PermissionsDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Scopes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="McpScopeCheckBox" IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}"
                                                      Margin="0,0,0,10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <!-- Apply sits with the observed state it changes; the endpoint stays inside that card. -->
                            <components:SettingRow Icon="&#xE946;" Title="{Binding StatusText}" Description="{Binding Status}">
                                <components:SettingRow.ActionContent>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding RefreshText}" Click="McpRefresh_Click" />
                                        <Button x:Name="McpApplyButton" Content="{Binding ApplyText}" Click="McpApply_Click" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </components:SettingRow.ActionContent>
                                <components:SettingRow.DetailContent>
                                    <TextBlock Text="{Binding Endpoint}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasEndpoint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </components:SettingRow.DetailContent>
                            </components:SettingRow>
                            <components:SettingRow Icon="&#xE8C8;" Title="{Binding ClientText}" Description="{Binding ClientDescriptionText}">
                                <components:SettingRow.ActionContent>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="McpShowConfigurationButton" Content="{Binding ShowText}" Click="McpShow_Click" IsEnabled="{Binding CanCopy}" />
                                        <Button x:Name="McpCopyButton" Content="{Binding CopyText}" Click="McpCopy_Click" IsEnabled="{Binding CanCopy}" />
                                    </StackPanel>
                                </components:SettingRow.ActionContent>
                            </components:SettingRow>
                            <components:SettingRow Icon="&#xE8D7;" Title="{Binding CredentialText}" Description="{Binding CredentialDescriptionText}">
                                <components:SettingRow.ActionContent>
                                    <Button Content="{Binding RotateText}" Click="McpRotate_Click" />
                                </components:SettingRow.ActionContent>
                            </components:SettingRow>
                            <HyperlinkButton Content="{Binding ResetText}" Click="McpReset_Click" HorizontalAlignment="Right" Padding="0" Margin="0,0,8,0" />
                            </StackPanel>
                    </ContentControl>

                    <TextBlock x:Name="DataSectionTitleText" Text="{Binding DataSectionTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <components:SettingRow x:Name="DataPackageRow" Icon="&#xE74E;" Title="{Binding BackupRestoreTitleText}" Description="{Binding BackupRestoreDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="ExportDataPackageButton" Click="ExportDataPackageButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="{Binding ExportText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportDataPackageButton" Click="ImportDataPackageButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                        <TextBlock Text="{Binding ImportText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ResetAllSettingsRow" Icon="&#xE72C;" Title="{Binding ResetAllSettingsTitleText}" Description="{Binding ResetAllSettingsDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <HyperlinkButton x:Name="ResetAllSettingsLink" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding ResetText}" Click="ResetAllSettingsButton_Click" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>

                    <components:SettingRow x:Name="ClearAllDataRow" Icon="&#xE74D;" Title="{Binding ClearAllDataTitleText}" Description="{Binding ClearAllDataDescriptionText}">
                        <components:SettingRow.ActionContent>
                            <HyperlinkButton x:Name="ClearAllDataLink" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding CleanupText}" Click="ClearAllDataButton_Click" />
                        </components:SettingRow.ActionContent>
                    </components:SettingRow>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- Keep the current MCP result visible while the long preferences page scrolls. -->
        <Grid x:Name="McpFeedbackHost" Grid.Row="1" Padding="24,0,24,24"
              Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1040" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="McpFeedbackBar" Title="{Binding TitleText}" Message="{Binding Message}"
                     IsOpen="{Binding IsMessageOpen, Mode=TwoWay}" IsClosable="True"
                     Severity="{Binding MessageSeverity, Converter={StaticResource PageStatusSeverityConverter}}" />
        </Grid>
    </Grid>
</Page>
