<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:ClashSharp.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="AboutDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutInformationRowStyle" TargetType="components:SettingRow">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>
    <ScrollViewer
        x:Name="AboutScrollViewer"
        Background="Transparent"
        Padding="{StaticResource ClashPagePadding}"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource ClashReadingPagePanelStyle}" MaxWidth="840" HorizontalAlignment="Center" Spacing="24">
            <TextBlock Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <StackPanel x:Name="AboutBrand" Spacing="4" MaxWidth="480" HorizontalAlignment="Center">
                <Image x:Name="AboutLogo" Source="ms-appx:///Assets/Square150x150Logo.scale-400.png" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" AutomationProperties.Name="{Binding AppNameText}" />
                <TextBlock Text="{Binding AppNameText}" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{Binding VersionSummaryText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Text="{Binding AppDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="AboutInformationRows" Spacing="4">
                <components:SettingRow x:Name="UpdateCard" Style="{StaticResource AboutInformationRowStyle}" Title="{Binding UpdateTitleText}" Description="{Binding UpdateStatusText}">
                    <components:SettingRow.ActionContent>
                        <Button Command="{Binding OpenReleasesCommand}" Content="{Binding OpenReleasesButtonText}" />
                    </components:SettingRow.ActionContent>
                    <components:SettingRow.DetailContent>
                        <TextBlock Text="{Binding UpdateDescriptionText}" Style="{StaticResource AboutDescriptionStyle}" Margin="0,8,0,0" />
                    </components:SettingRow.DetailContent>
                </components:SettingRow>
                <components:SettingRow x:Name="ProxyInformationCard" Style="{StaticResource AboutInformationRowStyle}" Title="{Binding ProxyInformationTitleText}" Description="{Binding ProxyEntryText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="ProxyInformationButton" Click="OpenProxyInformationButton_Click" Content="{Binding ProxyInformationButtonText}" ToolTipService.ToolTip="{Binding ProxyInformationDescriptionText}" />
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
                <components:SettingRow x:Name="GitHubCard" Style="{StaticResource AboutInformationRowStyle}" Title="{Binding GitHubTitleText}" Description="{Binding GitHubDescriptionText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="GitHubButton" Command="{Binding OpenGitHubCommand}" Content="{Binding GitHubButtonText}" />
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
                <components:SettingRow x:Name="MihomoCard" Style="{StaticResource AboutInformationRowStyle}" Title="{Binding MihomoTitleText}" Description="{Binding MihomoStatusText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="MihomoButton" Command="{Binding OpenMihomoCommand}" Content="{Binding MihomoButtonText}" />
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
                <Expander x:Name="AboutInformationExpander" Header="{Binding InformationTitleText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="12">
                            <TextBlock Text="{Binding RuntimeTitleText}" Style="{StaticResource AboutDescriptionStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeValueText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="AuthorTitleText" Grid.Row="1" Text="{Binding AuthorTitleText}" Style="{StaticResource AboutDescriptionStyle}" />
                            <TextBlock x:Name="AuthorValueText" Grid.Row="1" Grid.Column="1" Text="{Binding AuthorValueText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="LicenseTitleText" Grid.Row="2" Text="{Binding LicenseTitleText}" Style="{StaticResource AboutDescriptionStyle}" />
                            <TextBlock x:Name="LicenseValueText" Grid.Row="2" Grid.Column="1" Text="{Binding LicenseValueText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                        <TextBlock Text="{Binding MihomoDescriptionText}" Style="{StaticResource AboutDescriptionStyle}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
