<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSharp.View.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:ClashSharp.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="AboutSpecLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutSpecValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>
    <ScrollViewer
        x:Name="AboutScrollViewer"
        Background="Transparent"
        Padding="{StaticResource ClashPagePadding}"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1040" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="AboutContentPanel" Style="{StaticResource ClashReadingPagePanelStyle}" Spacing="{StaticResource ClashSettingsCardSpacing}">
                <TextBlock Text="{Binding PageTitleText}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />

                <!-- Identity header, modeled on the device card at the top of Windows Settings > System > About. -->
                <Grid x:Name="AboutBrand" Style="{StaticResource ClashSurfaceCardStyle}" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutLogo" Source="ms-appx:///Assets/Square150x150Logo.scale-400.png" Width="64" Height="64" Stretch="Uniform"
                           VerticalAlignment="Center" AutomationProperties.Name="{Binding AppNameText}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppNameText}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding VersionSummaryText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding AppDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Application information: an always-open specification group with a copy action in its header. -->
                <Grid x:Name="AboutInformationCard" Style="{StaticResource ClashSettingsCardStyle}" Padding="0" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="{StaticResource ClashSettingsCardPadding}" MinHeight="66" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource ClashCardIconStyle}" Margin="2,0,2,0" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{Binding InformationTitleText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                        <Button x:Name="CopyInformationButton" Grid.Column="2" MinWidth="96" VerticalAlignment="Center"
                                Click="CopyInformationButton_Click" AutomationProperties.Name="{Binding CopyText}">
                            <Grid>
                                <StackPanel x:Name="CopyIdleContent" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="{Binding CopyText}" />
                                </StackPanel>
                                <StackPanel x:Name="CopyFeedbackContent" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                    <FontIcon x:Name="CopyFeedbackGlyph" Glyph="&#xE73E;" FontSize="14" />
                                    <TextBlock x:Name="CopyFeedbackText" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid x:Name="AboutSpecifications" Grid.Row="2" Padding="58,16,16,18" ColumnSpacing="32" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding VersionLabelText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionDetailText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock Grid.Row="1" Text="{Binding BuildTimeTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildTimeValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock Grid.Row="2" Text="{Binding CoreTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock Grid.Row="3" Text="{Binding RuntimeTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock Grid.Row="4" Text="{Binding ProxyInformationTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LocalProxyValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock x:Name="AuthorTitleText" Grid.Row="5" Text="{Binding AuthorTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock x:Name="AuthorValueText" Grid.Row="5" Grid.Column="1" Text="{Binding AuthorValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                        <TextBlock x:Name="LicenseTitleText" Grid.Row="6" Text="{Binding LicenseTitleText}" Style="{StaticResource AboutSpecLabelStyle}" />
                        <TextBlock x:Name="LicenseValueText" Grid.Row="6" Grid.Column="1" Text="{Binding LicenseValueText}" Style="{StaticResource AboutSpecValueStyle}" />
                    </Grid>
                </Grid>

                <TextBlock Text="{Binding RelatedTitleText}" Style="{StaticResource ClashSectionHeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                <components:SettingRow x:Name="UpdateCard" Icon="&#xE895;" Title="{Binding UpdateTitleText}" Description="{Binding UpdateStatusText}">
                    <components:SettingRow.ActionContent>
                        <Button Command="{Binding OpenReleasesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding OpenReleasesButtonText}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </components:SettingRow.ActionContent>
                    <components:SettingRow.DetailContent>
                        <TextBlock Text="{Binding UpdateDescriptionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </components:SettingRow.DetailContent>
                </components:SettingRow>
                <components:SettingRow x:Name="ProxyInformationCard" Icon="&#xE968;" Title="{Binding ProxyInformationTitleText}" Description="{Binding ProxyInformationDescriptionText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="ProxyInformationButton" Click="OpenProxyInformationButton_Click" Content="{Binding ProxyInformationButtonText}" />
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
                <components:SettingRow x:Name="GitHubCard" Icon="&#xE943;" Title="{Binding GitHubTitleText}" Description="{Binding GitHubDescriptionText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="GitHubButton" Command="{Binding OpenGitHubCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding GitHubButtonText}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
                <components:SettingRow x:Name="MihomoCard" Icon="&#xE9F5;" Title="{Binding MihomoTitleText}" Description="{Binding MihomoDescriptionText}">
                    <components:SettingRow.ActionContent>
                        <Button x:Name="MihomoButton" Command="{Binding OpenMihomoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding MihomoButtonText}" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </components:SettingRow.ActionContent>
                </components:SettingRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
