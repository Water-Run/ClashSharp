<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClashSharp.Components.SearchableOptionList"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:ClashSharp.Components">

    <UserControl.Resources>
        <DataTemplate x:Key="OptionContentTemplate">
            <components:DialogOptionRow
                Title="{Binding Title}"
                Metadata="{Binding Metadata}"
                Description="{Binding Description}"
                Glyph="{Binding Glyph}"
                HorizontalAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate x:Key="RadioOptionTemplate">
            <RadioButton
                Content="{Binding}"
                ContentTemplate="{StaticResource OptionContentTemplate}"
                IsChecked="{Binding IsChecked, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                MinHeight="64"
                Padding="12,6,0,6"
                AutomationProperties.Name="{Binding Title}"
                AutomationProperties.HelpText="{Binding Description}" />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <TextBox
            x:Name="SearchBox"
            Header="{Binding SearchHeader, ElementName=Root}"
            PlaceholderText="{Binding SearchPlaceholder, ElementName=Root}"
            HorizontalAlignment="Stretch"
            TextChanged="SearchBox_TextChanged" />

        <Grid Height="{Binding MaxListHeight, ElementName=Root}">
            <ListView
                x:Name="MultipleOptionsControl"
                ItemTemplate="{StaticResource OptionContentTemplate}"
                Visibility="Collapsed"
                MaxHeight="{Binding MaxListHeight, ElementName=Root}"
                SelectionMode="Multiple"
                IsMultiSelectCheckBoxEnabled="True"
                ContainerContentChanging="MultipleOptionsControl_ContainerContentChanging"
                SelectionChanged="MultipleOptionsControl_SelectionChanged"
                HorizontalAlignment="Stretch"
                Padding="0,0,14,0"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="MinHeight" Value="72" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <ScrollViewer
                x:Name="SingleOptionsScroller"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,14,0">
                <RadioButtons
                    x:Name="SingleOptionsControl"
                    MaxColumns="1"
                    ItemTemplate="{StaticResource RadioOptionTemplate}"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SingleOptionsControl_SelectionChanged" />
            </ScrollViewer>
            <TextBlock
                x:Name="EmptyStateText"
                Text="{Binding EmptyText, ElementName=Root}"
                Visibility="Collapsed"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>
