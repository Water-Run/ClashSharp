<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClashSharp.Components.StartupGuideDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashSharp.Components"
    MinWidth="0"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <Style TargetType="local:StartupGuideDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
        <x:Double x:Key="ContentDialogMinWidth">360</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <StackPanel MinWidth="360" MaxWidth="512" Spacing="16">
        <TextBlock x:Name="GuideDescriptionText" TextWrapping="WrapWholeWords" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="SummaryBar" IsOpen="True" IsClosable="False" Severity="Informational" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressRing x:Name="RefreshProgress" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" />
                <TextBlock x:Name="BusyText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <HyperlinkButton x:Name="RefreshButton" Grid.Column="1" Padding="0" />
        </Grid>
        <InfoBar x:Name="RefreshError" IsOpen="False" IsClosable="False" Severity="Error" />
        <ScrollViewer x:Name="ChecksScroll" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ChecksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16" BorderThickness="1" CornerRadius="8"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="24" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top"
                                          Loaded="StatusIcon_Loaded"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Grid.Column="1" Padding="8,2" CornerRadius="4"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                                            <TextBlock Loaded="StatusText_Loaded" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" TextWrapping="WrapWholeWords"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <HyperlinkButton Padding="0" HorizontalAlignment="Left" Loaded="CheckAction_Loaded" Click="CheckAction_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
