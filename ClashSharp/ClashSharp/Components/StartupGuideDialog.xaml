<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClashSharp.Components.StartupGuideDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashSharp.Components"
    MinWidth="0"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <Style TargetType="local:StartupGuideDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" />
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">688</x:Double>
    </ContentDialog.Resources>

    <StackPanel x:Name="GuideContent" Width="640" Spacing="16">
        <TextBlock x:Name="GuideDescriptionText" TextWrapping="WrapWholeWords" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="SummaryBar" IsOpen="True" IsClosable="False" Severity="Informational"
                     Background="Transparent" BorderThickness="0" Padding="0" />
            <HyperlinkButton x:Name="RefreshButton" Grid.Column="1" Padding="0" VerticalAlignment="Center" />
        </Grid>
        <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <ProgressRing x:Name="RefreshProgress" Width="16" Height="16" MinWidth="0" MinHeight="0" IsActive="False" />
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
        <InfoBar x:Name="RefreshError" IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed" />
        <ScrollViewer x:Name="ChecksScroll" Background="Transparent" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch" Padding="0,0,12,0">
            <ItemsControl x:Name="ChecksList" Width="612" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,12" ColumnSpacing="16" BorderThickness="0,1,0,0"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Width="24" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top"
                                      Loaded="StatusIcon_Loaded"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MaxWidth="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Loaded="StatusText_Loaded" TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Description}" TextWrapping="WrapWholeWords"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Padding="0" HorizontalAlignment="Left" Loaded="CheckAction_Loaded" Click="CheckAction_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
