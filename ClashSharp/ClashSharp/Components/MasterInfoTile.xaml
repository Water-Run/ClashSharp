<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClashSharp.Components.MasterInfoTile"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="TileRoot"
        Style="{StaticResource ClashCardGridStyle}"
        MinHeight="116"
        RowSpacing="10">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="TileScaleTransform" CenterX="110" CenterY="58" />
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.06" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.06" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.99" Duration="0:0:0.06" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="TileStateGroup">
                <VisualState x:Name="TileOff">
                    <VisualState.Setters>
                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="DetailText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="HistoryLine.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="TileOn">
                    <VisualState.Setters>
                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="DetailText.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="HistoryLine.Stroke" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="SelectedOverlay"
            Grid.RowSpan="2"
            Margin="-16"
            CornerRadius="0"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Opacity="0" />
        <Border
            x:Name="HoverOverlay"
            Grid.RowSpan="2"
            Margin="-16"
            CornerRadius="0"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Opacity="0" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="GlyphIcon"
                Glyph="{Binding Glyph, ElementName=Root}"
                FontSize="18"
                Width="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Text="{Binding Title, ElementName=Root}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Bottom">
            <TextBlock
                x:Name="ValueText"
                Text="{Binding Value, ElementName=Root}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DetailText"
                Text="{Binding Detail, ElementName=Root}"
                MaxLines="1"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
            <Canvas x:Name="HistoryCanvas" Grid.Column="1" Width="72" Height="36" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                <Polyline x:Name="HistoryLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
            </Canvas>
        </Grid>

        <Button
            x:Name="TileButton"
            Grid.RowSpan="2"
            Margin="-16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            UseSystemFocusVisuals="True"
            AutomationProperties.Name="{Binding Title, ElementName=Root}"
            AutomationProperties.HelpText="{Binding Value, ElementName=Root}"
            Click="TileButton_Click"
            PointerEntered="TileRoot_PointerEntered"
            PointerExited="TileRoot_PointerExited">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="TileDetailsFlyout" Opened="TileDetailsFlyout_Opened">
                    <ScrollViewer x:Name="TileDetailsScroller" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8" MaxWidth="420">
                            <TextBlock
                                AutomationProperties.AutomationId="TileDetailsText"
                                Text="{x:Bind GetDetailText(Title, Value, Detail, Description), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                            <HyperlinkButton
                                AutomationProperties.AutomationId="TileDetailsNavigation"
                                Visibility="{x:Bind GetNavigationVisibility(NavigationCommand, NavigationText), Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="0"
                                Click="TileDetailsNavigation_Click">
                                <TextBlock Text="{x:Bind NavigationText, Mode=OneWay}" TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </StackPanel>
                    </ScrollViewer>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <ToolTipService.ToolTip>
                <ToolTip>
                    <TextBlock MaxWidth="360" Text="{x:Bind GetTooltipText(Value, Detail, Description), Mode=OneWay}" TextWrapping="Wrap" />
                </ToolTip>
            </ToolTipService.ToolTip>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ProgressRing
            x:Name="ExecutionProgress"
            Grid.Row="1"
            Width="18"
            Height="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            IsActive="False"
            Visibility="Collapsed"
            AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
