<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClashSharp.Components.MasterInfoTile"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClashSharp.Converters">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid
        x:Name="TileRoot"
        Style="{StaticResource ClashCardGridStyle}"
        MinHeight="116"
        RowSpacing="10">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="TileScaleTransform" CenterX="110" CenterY="58" />
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.12" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.06" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.06" />
                        <DoubleAnimation Storyboard.TargetName="TileScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.99" Duration="0:0:0.06" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SwitchStates">
                <VisualState x:Name="SwitchOff">
                    <VisualState.Setters>
                        <Setter Target="SwitchTrack.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                        <Setter Target="ToggleThumb.Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetName="ToggleThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="SwitchOn">
                    <VisualState.Setters>
                        <Setter Target="SwitchTrack.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="ToggleThumb.Background" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.18" />
                        <DoubleAnimation Storyboard.TargetName="ToggleThumbTransform" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="SelectedOverlay"
            Grid.RowSpan="2"
            Margin="-16"
            CornerRadius="4"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Opacity="0" />
        <Border
            x:Name="HoverOverlay"
            Grid.RowSpan="2"
            Margin="-16"
            CornerRadius="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Opacity="0" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Glyph="{Binding Glyph, ElementName=Root}"
                FontSize="18"
                Width="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding Title, ElementName=Root}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <Border
                x:Name="SwitchTrack"
                Grid.Column="2"
                Width="36"
                Height="20"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                Background="{ThemeResource ControlFillColorTertiaryBrush}"
                Visibility="{Binding IsToggleVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border
                    x:Name="ToggleThumb"
                    Width="14"
                    Height="14"
                    Margin="2"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Background="{ThemeResource TextFillColorSecondaryBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToggleThumbTransform" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Bottom">
            <TextBlock
                Text="{Binding Value, ElementName=Root}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{Binding Detail, ElementName=Root}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
            <Canvas x:Name="HistoryCanvas" Grid.Column="1" Width="72" Height="36" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                <Polyline x:Name="HistoryLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
            </Canvas>
        </Grid>

        <Button
            x:Name="TileButton"
            Grid.RowSpan="2"
            Margin="-16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            UseSystemFocusVisuals="True"
            AutomationProperties.Name="{Binding Title, ElementName=Root}"
            AutomationProperties.HelpText="{Binding Value, ElementName=Root}"
            Click="TileButton_Click"
            PointerEntered="TileRoot_PointerEntered"
            PointerExited="TileRoot_PointerExited">
            <ToolTipService.ToolTip>
                <ToolTip>
                    <StackPanel MaxWidth="360" Spacing="4">
                        <TextBlock Text="{Binding Value, ElementName=Root}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail, ElementName=Root}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ProgressRing
            x:Name="ExecutionProgress"
            Grid.Row="1"
            Width="18"
            Height="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            IsActive="False"
            Visibility="Collapsed"
            AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
